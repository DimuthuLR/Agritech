# Normalize line endings for all text files
* text=auto

# Windows-specific files should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Force LF for shell scripts and Python (cross-platform safety)
*.sh text eol=lf
*.py text eol=lf

# Binary files — never touch
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.zip binary